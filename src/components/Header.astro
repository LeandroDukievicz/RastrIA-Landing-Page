---
---
<header>
	<div class="container header-content">
		<a class="logo" href="#" aria-label="RastrIA - início">
			<span class="logo-icon" aria-hidden="true">
				<svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
			</span>
			<span>RastrIA</span>
		</a>

		<nav aria-label="Principal">
			<ul class="nav-links">
				<li><a href="#features">Recursos</a></li>
				<li><a href="#how-it-works">Operação</a></li>
				<li><a href="#use-cases">Aplicações</a></li>
			</ul>
		</nav>

		<div class="actions">
			<button id="theme-toggle" class="theme-btn" type="button" aria-label="Alternar tema" aria-pressed="false">
				<span class="sun-icon" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
				</span>
				<span class="moon-icon" aria-hidden="true">
					<svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
				</span>
			</button>
			<a href="#contact" class="btn btn-primary compact">Solicitar demo</a>
		</div>
	</div>
</header>

<script>
	const themeToggle = document.getElementById('theme-toggle');
	const root = document.documentElement;

	const syncToggle = () => {
		const isDark = root.dataset.theme === 'dark';
		themeToggle?.setAttribute('aria-pressed', String(isDark));
	};

	syncToggle();

	themeToggle?.addEventListener('click', () => {
		const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = nextTheme;
		root.style.colorScheme = nextTheme;
		localStorage.setItem('theme', nextTheme);
		syncToggle();
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding: 0.75rem 0;
		background: rgb(var(--bg-rgb) / 0.82);
		backdrop-filter: blur(18px);
		border-bottom: 1px solid transparent;
		transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
	}

	header.is-scrolled {
		border-bottom-color: color-mix(in oklab, var(--border) 80%, transparent);
		box-shadow: 0 10px 30px -24px rgb(20 31 28 / 0.5);
	}

	.header-content {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-weight: 800;
		font-size: 1.08rem;
	}

	.logo-icon {
		width: 2.35rem;
		height: 2.35rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--primary);
		color: var(--primary-fg);
		border-radius: var(--radius);
		box-shadow: 0 12px 30px -22px var(--primary);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.25rem;
		background: color-mix(in oklab, var(--surface) 72%, transparent);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.nav-links a {
		display: inline-flex;
		align-items: center;
		min-height: 2.25rem;
		padding: 0 0.85rem;
		border-radius: 6px;
		font-size: 0.9rem;
		font-weight: 650;
		color: var(--fg-muted);
		transition: background 0.2s ease, color 0.2s ease;
	}

	.nav-links a:hover {
		background: var(--surface-soft);
		color: var(--fg);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.theme-btn {
		width: 2.75rem;
		height: 2.75rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--fg);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		cursor: pointer;
		transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}

	.theme-btn:hover {
		background: var(--surface-soft);
		border-color: var(--border-strong);
		transform: translateY(-1px);
	}

	.sun-icon {
		display: none;
	}

	:global(:root[data-theme="dark"]) .sun-icon {
		display: inline-flex;
	}

	:global(:root[data-theme="dark"]) .moon-icon {
		display: none;
	}

	@media (max-width: 820px) {
		nav {
			display: none;
		}
	}

	@media (max-width: 520px) {
		header {
			padding: 0.6rem 0;
		}

		.logo span:last-child {
			display: none;
		}

		.compact {
			width: auto;
			padding-inline: 0.85rem;
			font-size: 0.88rem;
		}
	}
</style>
