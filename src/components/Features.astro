---
const features = [
	{
		title: "Rastreamento operacional",
		description: "Mapa vivo com veículos online, status de conexão, histórico de posição e contexto da viagem em andamento.",
		icon: "map",
		metric: "GPS + status"
	},
	{
		title: "Check-in e check-out",
		description: "Registro de motorista, hodômetro, combustível e fotos antes da saída e no retorno do veículo.",
		icon: "clipboard",
		metric: "prova de uso"
	},
	{
		title: "Alertas de risco",
		description: "Excesso de velocidade, paradas não previstas, saída de rota e uso fora da política aparecem no painel.",
		icon: "alert",
		metric: "ação rápida"
	},
	{
		title: "Análise por IA",
		description: "Resumo automático de cada trajeto, anomalias detectadas e recomendações para o gestor priorizar decisões.",
		icon: "sparkles",
		metric: "menos leitura manual"
	},
	{
		title: "Indicadores executivos",
		description: "KPIs de utilização, ociosidade, quilômetros rodados, ocorrências e veículos mais demandados.",
		icon: "chart",
		metric: "visão gerencial"
	},
	{
		title: "Auditoria completa",
		description: "Linha do tempo por veículo e motorista, com evidências organizadas para prestação de contas.",
		icon: "list",
		metric: "histórico confiável"
	}
];
---
<section id="features" class="features">
	<div class="container">
		<div class="section-header">
			<p class="section-kicker">Recursos principais</p>
			<h2>Da retirada do veículo ao relatório final, tudo fica rastreável.</h2>
			<p>O RastrIA combina dados operacionais, alertas e inteligência para reduzir uso indevido, acelerar respostas e dar previsibilidade para a gestão.</p>
		</div>
		<div class="features-grid">
			{features.map((feature) => (
				<article class="feature-card">
					<div class="feature-top">
						<div class="feature-icon">
							{feature.icon === "map" && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M14.1 5.1 9.9 3.7a2 2 0 0 0-1.3 0L3.4 5.5A2 2 0 0 0 2 7.4v11.2a1 1 0 0 0 1.3.95l5.3-1.75a2 2 0 0 1 1.3 0l4.2 1.4a2 2 0 0 0 1.3 0l5.2-1.75a2 2 0 0 0 1.4-1.9V4.4a1 1 0 0 0-1.3-.95l-5.3 1.75a2 2 0 0 1-1.3 0Z"/><path d="M9 4v14"/><path d="M15 6v14"/></svg>}
							{feature.icon === "clipboard" && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-5"/></svg>}
							{feature.icon === "alert" && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>}
							{feature.icon === "sparkles" && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>}
							{feature.icon === "chart" && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect width="3" height="8" x="7" y="9" rx="1"/><rect width="3" height="13" x="13" y="4" rx="1"/><rect width="3" height="5" x="19" y="12" rx="1"/></svg>}
							{feature.icon === "list" && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>}
						</div>
						<span>{feature.metric}</span>
					</div>
					<h3>{feature.title}</h3>
					<p>{feature.description}</p>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.features {
		background: var(--surface-soft);
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.feature-card {
		min-height: 245px;
		display: flex;
		flex-direction: column;
		padding: 1.35rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.feature-card:hover {
		transform: translateY(-4px);
		border-color: color-mix(in oklab, var(--primary) 46%, var(--border));
		box-shadow: var(--shadow-strong);
	}

	.feature-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.35rem;
	}

	.feature-icon {
		width: 3rem;
		height: 3rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--primary);
		background: var(--primary-soft);
		border-radius: var(--radius);
	}

	.feature-top span {
		color: var(--fg-soft);
		font-size: 0.78rem;
		font-weight: 750;
		text-align: right;
	}

	.feature-card h3 {
		margin-bottom: 0.75rem;
		font-size: 1.18rem;
	}

	.feature-card p {
		font-size: 0.96rem;
	}

	@media (max-width: 960px) {
		.features-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 620px) {
		.features-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
