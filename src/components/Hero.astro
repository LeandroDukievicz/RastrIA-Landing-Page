---
const metrics = [
	{ value: "18%", label: "menos desvios de rota" },
	{ value: "42 min", label: "economia por ocorrência" },
	{ value: "24/7", label: "visibilidade operacional" }
];
---
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-content">
			<p class="section-kicker" data-anim="hero">Gestão inteligente de frota</p>
			<h1 data-anim="hero">RastrIA coloca localização, check-in e análise de trajetos no mesmo painel.</h1>
			<p class="hero-copy" data-anim="hero">Controle o uso de veículos corporativos com dados de GPS, registros de retirada e devolução, alertas críticos e resumos automáticos por IA para cada viagem.</p>
			<div class="hero-actions" data-anim="hero">
				<a href="#contact" class="btn btn-primary">
					Solicitar demo
					<svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
				<a href="#features" class="btn btn-outline">Explorar recursos</a>
			</div>
			<div class="hero-metrics" aria-label="Indicadores da plataforma" data-anim="hero">
				{metrics.map((metric) => (
					<div class="metric">
						<strong>{metric.value}</strong>
						<span>{metric.label}</span>
					</div>
				))}
			</div>
		</div>

		<div class="product-stage" aria-label="Prévia visual do painel RastrIA" data-anim="hero-stage">
			<div class="dashboard-window">
				<div class="window-bar">
					<span></span>
					<span></span>
					<span></span>
					<strong>Operação em tempo real</strong>
				</div>
				<div class="dashboard-body">
					<div class="map-panel">
						<div class="route-line route-one"></div>
						<div class="route-line route-two"></div>
						<div class="vehicle-pin primary-pin">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
						</div>
						<div class="vehicle-pin alert-pin">
							<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
						</div>
						<div class="map-label live">
							<span></span>
							12 veículos online
						</div>
					</div>
					<div class="side-panel">
						<div class="status-card">
							<span class="status-label">Veículo em uso</span>
							<strong>Fiat Strada Endurance</strong>
							<small>Placa RKM-3F47 · Motorista: Ana Souza</small>
							<div class="status-grid">
								<span>2h 14m</span>
								<span>47,3 km</span>
								<span>78% comb.</span>
							</div>
						</div>
						<div class="ai-card">
							<div class="ai-icon">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
							</div>
							<div>
								<strong>Resumo IA</strong>
								<p>Trajeto compatível com destino. Uma parada não prevista de 8 min foi registrada.</p>
							</div>
						</div>
						<div class="alert-row">
							<span>Alerta</span>
							<strong>102 km/h</strong>
						</div>
					</div>
				</div>
			</div>

			<figure class="phone-preview" data-anim="hero-phone">
				<img
					src="/app/app-checkout.webp"
					alt="Tela de check-out do app RastrIA: seleção do veículo, hodômetro inicial, combustível, destino previsto e foto obrigatória de saída"
					width="367"
					height="821"
					loading="eager"
					decoding="async"
				/>
			</figure>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding: clamp(3.5rem, 2rem + 4vw, 5.5rem) 0 var(--section-y);
		overflow: hidden;
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: 0 0 auto;
		height: 34rem;
		background:
			linear-gradient(120deg, color-mix(in oklab, var(--primary-soft) 70%, transparent), transparent 48%),
			linear-gradient(240deg, color-mix(in oklab, var(--accent-soft) 45%, transparent), transparent 48%);
		pointer-events: none;
	}

	.hero-grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.18fr);
		align-items: center;
		gap: clamp(2.5rem, 1rem + 3vw, 3.5rem);
	}

	h1 {
		margin-bottom: 1.25rem;
	}

	.hero-copy {
		max-width: 34rem;
		font-size: var(--lead);
		margin-bottom: 2rem;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 2.5rem;
	}

	/* indicadores como faixa unica com divisores, em vez de tres caixas soltas */
	.hero-metrics {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		max-width: 34rem;
		padding: 1.15rem 0.25rem;
		background: color-mix(in oklab, var(--surface) 70%, transparent);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}

	.metric {
		padding: 0 1.15rem;
	}

	.metric + .metric {
		border-left: 1px solid var(--border);
	}

	.metric strong {
		display: block;
		font-size: 1.4rem;
		line-height: 1.1;
		color: var(--fg);
		margin-bottom: 0.3rem;
	}

	.metric span {
		display: block;
		color: var(--fg-muted);
		font-size: 0.83rem;
		line-height: 1.35;
	}

	.product-stage {
		position: relative;
		padding-bottom: 1.75rem;
	}

	.dashboard-window {
		position: relative;
		width: min(100%, 540px);
		margin-left: auto;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-strong);
		overflow: hidden;
	}

	.window-bar {
		height: 3rem;
		display: flex;
		align-items: center;
		gap: 0.48rem;
		padding: 0 1rem;
		border-bottom: 1px solid var(--border);
		background: var(--surface-soft);
	}

	.window-bar span {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: var(--border-strong);
	}

	.window-bar span:first-child {
		background: var(--danger);
	}

	.window-bar span:nth-child(2) {
		background: var(--accent);
	}

	.window-bar span:nth-child(3) {
		background: var(--ok);
	}

	.window-bar strong {
		margin-left: auto;
		color: var(--fg-muted);
		font-size: 0.78rem;
		font-weight: 700;
	}

	.dashboard-body {
		display: grid;
		grid-template-columns: 1.02fr 0.98fr;
		min-height: 360px;
	}

	.map-panel {
		position: relative;
		overflow: hidden;
		background-color: var(--surface-soft);
		background-image:
			linear-gradient(to right, color-mix(in oklab, var(--border) 78%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in oklab, var(--border) 78%, transparent) 1px, transparent 1px);
		background-size: 34px 34px;
	}

	.map-panel::before {
		content: "";
		position: absolute;
		inset: 14%;
		border: 1px solid color-mix(in oklab, var(--primary) 38%, transparent);
		border-radius: 50%;
		transform: rotate(-12deg);
	}

	.route-line {
		position: absolute;
		height: 6px;
		border-radius: 999px;
		background: var(--primary);
		box-shadow: 0 0 0 5px color-mix(in oklab, var(--primary) 15%, transparent);
	}

	.route-one {
		width: 260px;
		left: 16%;
		top: 38%;
		transform: rotate(-26deg);
	}

	.route-two {
		width: 210px;
		right: 12%;
		bottom: 30%;
		transform: rotate(31deg);
		background: var(--accent);
		box-shadow: 0 0 0 5px color-mix(in oklab, var(--accent) 16%, transparent);
	}

	.vehicle-pin {
		position: absolute;
		width: 2.75rem;
		height: 2.75rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: var(--surface);
		border: 1px solid var(--border);
		box-shadow: var(--shadow);
	}

	.primary-pin {
		top: 29%;
		left: 42%;
		color: var(--primary);
	}

	.alert-pin {
		right: 22%;
		bottom: 22%;
		color: var(--danger);
	}

	.map-label {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.7rem;
		background: rgb(var(--bg-rgb) / 0.86);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		color: var(--fg);
		font-size: 0.82rem;
		font-weight: 750;
		backdrop-filter: blur(10px);
	}

	.live span {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--ok);
		box-shadow: 0 0 0 4px color-mix(in oklab, var(--ok) 18%, transparent);
	}

	.side-panel {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		padding: 1rem;
		border-left: 1px solid var(--border);
		background: color-mix(in oklab, var(--surface) 92%, var(--surface-soft));
	}

	.status-card,
	.ai-card,
	.alert-row {
		background: var(--surface-raised);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1rem;
		box-shadow: var(--shadow);
	}

	.status-label {
		display: inline-flex;
		margin-bottom: 0.75rem;
		padding: 0.28rem 0.5rem;
		background: var(--primary-soft);
		color: var(--primary);
		border-radius: 999px;
		font-size: 0.7rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0;
	}

	.status-card strong,
	.ai-card strong,
	.alert-row strong {
		display: block;
		color: var(--fg);
	}

	.status-card small {
		display: block;
		margin-top: 0.35rem;
		color: var(--fg-muted);
		line-height: 1.45;
	}

	.status-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.4rem;
		margin-top: 1rem;
	}

	.status-grid span {
		padding: 0.55rem 0.45rem;
		background: var(--surface-soft);
		border-radius: 6px;
		color: var(--fg);
		font-size: 0.72rem;
		font-weight: 750;
		text-align: center;
	}

	.ai-card {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.75rem;
	}

	.ai-card p {
		margin-top: 0.35rem;
		font-size: 0.82rem;
		line-height: 1.45;
	}

	.ai-icon {
		width: 2.2rem;
		height: 2.2rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius);
		color: var(--accent);
		background: var(--accent-soft);
	}

	.alert-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: auto;
		border-color: color-mix(in oklab, var(--danger) 36%, var(--border));
	}

	.alert-row span {
		color: var(--danger);
		font-size: 0.78rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0;
	}

	.phone-preview {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 170px;
		margin: 0;
		padding: 0.4rem;
		border-radius: 1.65rem;
		background: oklch(0.11 0.01 175);
		border: 1px solid oklch(0.26 0.01 175);
		box-shadow: var(--shadow-strong);
	}

	.phone-preview img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 1.3rem;
	}

	@media (max-width: 1060px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.hero-copy,
		.hero-metrics {
			max-width: 38rem;
		}

		.product-stage {
			max-width: 44rem;
			padding-bottom: 0;
		}

		.phone-preview {
			left: auto;
			right: -1.25rem;
			bottom: -1.25rem;
		}
	}

	@media (max-width: 720px) {
		.hero-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.hero-metrics {
			grid-template-columns: 1fr;
			padding: 0.25rem 0;
		}

		.metric {
			padding: 0.9rem 1.15rem;
		}

		.metric + .metric {
			border-left: 0;
			border-top: 1px solid var(--border);
		}

		.dashboard-body {
			grid-template-columns: 1fr;
		}

		.map-panel {
			min-height: 240px;
		}

		.side-panel {
			border-left: 0;
			border-top: 1px solid var(--border);
		}

		.phone-preview {
			display: none;
		}

		.window-bar strong {
			display: none;
		}
	}
</style>
